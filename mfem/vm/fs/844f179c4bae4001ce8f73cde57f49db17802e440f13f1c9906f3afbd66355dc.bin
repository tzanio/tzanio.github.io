#!/usr/bin/env python3
"""Force one example rebuild with an explicit optimization profile."""
import argparse
import os
from pathlib import Path
import re

parser = argparse.ArgumentParser(description='Build a local MFEM example; default is optimized (-O2).')
profile = parser.add_mutually_exclusive_group()
profile.add_argument('--fast', action='store_true', help='Use -O0 for faster iteration; executable code may run slower')
profile.add_argument('--optimized', action='store_true', help='Use -O2 for normal optimized execution')
parser.add_argument('target', help='Example target in this directory, such as ex1 or experiment')
options = parser.parse_args()
target = options.target
if not re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_.+-]*', target) or not Path(target + '.cpp').is_file():
    parser.error('Run from the example directory and name an existing C++ target, such as ex1.')
optimization = '-O0' if options.fast else '-O2'
label = 'fast iteration' if options.fast else 'optimized'
print(f'Building {target}: {label} ({optimization})', flush=True)
# Upstream Make does not track flags in target timestamps. Force only this
# source, so switching profiles always builds the requested executable and
# never invokes the library's special error recipe through make -B.
os.execvp('make', ['make', '-W', target + '.cpp', target,
                   'MFEM_CXXFLAGS=' + optimization + ' -std=c++17'])
